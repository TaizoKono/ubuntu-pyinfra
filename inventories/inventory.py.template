import getpass

# 実行時に一度だけパスワードの入力を求めるプロンプトを表示します。
# 収集したパスワードは各ホストの sudo_password として使用されます。
try:
    collected_password = getpass.getpass("Sudo password: ")
except EOFError:
    collected_password = None

target = [
    # 各ホストに共通のパスワードを割り当て
    # is_gpu: True の場合、update_kernel タスクで Nvidia ドライバも更新します
    ("ollo1-new", {"sudo_password": collected_password, "is_gpu": False}),
    ("ollo2-new", {"sudo_password": collected_password, "is_gpu": False}),
    ("ollo3-new", {"sudo_password": collected_password, "is_gpu": False}),
    ("ollo4-new", {"sudo_password": collected_password, "is_gpu": False}),
    ("ollo5-new", {"sudo_password": collected_password, "is_gpu": True}),
    ("ollo6-new", {"sudo_password": collected_password, "is_gpu": True}),
    ("ollo7-new", {"sudo_password": collected_password, "is_gpu": True}),
    ("ollo8-new", {"sudo_password": collected_password, "is_gpu": True}),
]
