import getpass

# 実行時に一度だけパスワードの入力を求めるプロンプトを表示します。
# 収集したパスワードは各ホストの sudo_password として使用されます。
try:
    collected_password = getpass.getpass("Sudo password: ")
except EOFError:
    collected_password = None

# 全ホスト共通のSSH接続ユーザー名
common_ssh_user = "ubuntu"

target = (
    [
        # is_gpu: True の場合、update_kernel タスクで Nvidia ドライバも更新します
        ("ubuntu1", {"is_gpu": False}),
        ("ubuntu2", {"is_gpu": False}),
        ("ubuntu3", {"is_gpu": False}),
        ("ubuntu4", {"is_gpu": False}),
        ("ubuntu5", {"is_gpu": True}),
        ("ubuntu6", {"is_gpu": True}),
        ("ubuntu7", {"is_gpu": True}),
        ("ubuntu8", {"is_gpu": True}),
    ],
    # 全ホストに共通のsudoパスワードを割り当て（実行時に入力したパスワードを使用）
    {"ssh_user": common_ssh_user, "sudo_password": collected_password},
)
