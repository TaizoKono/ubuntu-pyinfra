import getpass

# 実行時に一度だけパスワードの入力を求めるプロンプトを表示します。
# 収集したパスワードは各ホストの sudo_password として使用されます。
try:
    collected_password = getpass.getpass("Sudo password: ")
except EOFError:
    collected_password = None

target = [
    # 各ホストに共通のパスワードを割り当て
    # is_gpu: True の場合、update_kernel タスクで Nvidia ドライバも更新します
    ("ubuntu1", {"sudo_password": collected_password, "is_gpu": False}),
    ("ubuntu2", {"sudo_password": collected_password, "is_gpu": False}),
    ("ubuntu3", {"sudo_password": collected_password, "is_gpu": False}),
    ("ubuntu4", {"sudo_password": collected_password, "is_gpu": False}),
    ("ubuntu5", {"sudo_password": collected_password, "is_gpu": True}),
    ("ubuntu6", {"sudo_password": collected_password, "is_gpu": True}),
    ("ubuntu7", {"sudo_password": collected_password, "is_gpu": True}),
    ("ubuntu8", {"sudo_password": collected_password, "is_gpu": True}),
]
